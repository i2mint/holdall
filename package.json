{
  "name": "holdall",
  "version": "0.1.0",
  "description": "Agent-first client-side persistence and sharing: share links, local stores, file save/load, collection import with conflict plans, storage durability and install advice. Headless, with an optional zodal facade.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "holdall": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./zodal": {
      "import": {
        "types": "./dist/zodal.d.ts",
        "default": "./dist/zodal.js"
      },
      "require": {
        "types": "./dist/zodal.d.cts",
        "default": "./dist/zodal.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills",
    "agents"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node dist/cli.js encode examples/design.json | node dist/cli.js decode - && node -e \"require('./dist/index.cjs').planImport({a:1},{a:1})\""
  },
  "dependencies": {
    "browser-fs-access": "^0.38.0",
    "canonicalize": "^5.1.0",
    "fflate": "^0.8.3"
  },
  "peerDependencies": {
    "@zodal/store": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "@zodal/store": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@zodal/core": "^0.2.0",
    "@zodal/store": "^0.2.0",
    "jsdom": "^26.0.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/i2mint/holdall.git"
  },
  "keywords": [
    "persistence",
    "local-first",
    "share-link",
    "url-state",
    "localstorage",
    "indexeddb",
    "pwa",
    "export",
    "import",
    "agent-skills",
    "zodal"
  ],
  "packageManager": "pnpm@9.15.0",
  "typesVersions": {
    "*": {
      "zodal": [
        "./dist/zodal.d.ts"
      ]
    }
  }
}
